# PostgreSQL (Neon) connection strings.
#
# Copy this file to .env and fill in values from your Neon project
# (Dashboard -> Connect -> Prisma / "Connection string" tab).
#
# - DATABASE_URL: pooled connection (transaction mode via pgbouncer).
#   Used by the application at runtime.
# - DIRECT_URL: connection used by Prisma Migrate.
#
# Notes on connection parameters:
# - Only `sslmode=require` is used. `channel_binding=require` is NOT
#   supported by the Prisma engines and breaks connections, so it must
#   not be added.
# - From the local development network the native direct (non-pooler)
#   endpoint is not reachable (connections are reset), so DIRECT_URL
#   points at the pooled endpoint. On Vercel/CI the native direct
#   endpoint should be used instead:
#     postgresql://USER:PASSWORD@HOST.c-XX.aws.neon.tech/neondb?sslmode=require
#
# Required by Prisma commands: db:generate, db:migrate, db:studio and
# by the integration tests (tests/integration).

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-XX.us-east-1.aws.neon.tech/neondb?sslmode=require"

DIRECT_URL="postgresql://USER:PASSWORD@HOST-pooler.c-XX.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Real AI (production mode). Leave everything unset for the deterministic
# demo mode (default) — no network calls, no API key needed.
#
# AI_MODE=real            OpenCode Go LLM for all AI capabilities +
#                         real HTTP page analysis; SEO metrics stay UNKNOWN
#                         (no paid SEO source is configured), never synthetic.
# OPENCODE_API_KEY=       Required when AI_MODE=real (or DISCOVERY_MODE=real).
#                         Missing is a startup error — no silent fallback.
# OPENCODE_BASE_URL=      Default: https://opencode.ai/zen/go/v1
# OPENCODE_MODEL=         Default: deepseek-v4-pro
# OPENCODE_TIMEOUT_MS=    Default: 30000
# ---------------------------------------------------------------------------

AI_MODE="demo"
OPENCODE_API_KEY=""
OPENCODE_BASE_URL=""
OPENCODE_MODEL=""
OPENCODE_TIMEOUT_MS="30000"

# ---------------------------------------------------------------------------
# Real web discovery. DISCOVERY_MODE=real finds real external sites via the
# configured backend (DISCOVERY_PROVIDER) and persists them into the platform
# catalog. Requires OPENCODE_API_KEY for AI-planned search intents.
#
# DISCOVERY_MODE=real          Enable real web discovery.
# DISCOVERY_PROVIDER=          duckduckgo (default) — DuckDuckGo HTML search,
#                              no extra key. ai-search — a search-capable AI
#                              provider whose real citations become results
#                              (needs AI_SEARCH_* below).
# AI_SEARCH_API_KEY=           Required by DISCOVERY_PROVIDER=ai-search.
#                              Cannot reuse OPENCODE_API_KEY (plain LLM key).
# AI_SEARCH_BASE_URL=          Default: https://openrouter.ai/api/v1
# AI_SEARCH_MODEL=             Default: perplexity/sonar
# AI_SEARCH_CAPABILITIES=      Comma-separated endpoint capabilities; must
#                              include web_search,citations. Never guessed
#                              from a model name (startup error otherwise).
# AI_SEARCH_TIMEOUT_MS=        Default: 45000
#
# Cost/latency caps for real web discovery (serverless-safe):
# DISCOVERY_MAX_QUERIES=           Default: 10
# DISCOVERY_MAX_RESULTS_PER_QUERY= Default: 8
# DISCOVERY_MAX_CANDIDATES=        Default: 40
# DISCOVERY_CONCURRENCY=           Default: 2
# ---------------------------------------------------------------------------

DISCOVERY_MODE="demo"
DISCOVERY_PROVIDER="duckduckgo"
AI_SEARCH_API_KEY=""
AI_SEARCH_BASE_URL=""
AI_SEARCH_MODEL=""
AI_SEARCH_CAPABILITIES=""
AI_SEARCH_TIMEOUT_MS="45000"

# ---------------------------------------------------------------------------
# MOCK placement providers (demonstration placements against a simulator).
#
# MOCK_PROVIDERS=deny  (default) — production-safe: MOCK providers are
#                       excluded from the provider registry, so automated
#                       placement execution against synthetic providers is
#                       impossible (ADR-015). Manual flow keeps working.
# MOCK_PROVIDERS=allow — demo/test/preview only: binds MOCK implementations
#                       so the full placement lifecycle can be demonstrated.
#                       Never set "allow" in production.
# ---------------------------------------------------------------------------

MOCK_PROVIDERS="deny"
