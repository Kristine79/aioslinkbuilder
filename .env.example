# PostgreSQL (Neon) connection strings.
#
# Copy this file to .env and fill in values from your Neon project
# (Dashboard -> Connect -> Prisma / "Connection string" tab).
#
# - DATABASE_URL: pooled connection (transaction mode via pgbouncer).
#   Used by the application at runtime.
# - DIRECT_URL: direct (unpooled) connection. Used by Prisma Migrate.
#   This is the connection WITHOUT the "-pooler" host segment.
#
# Required by Prisma commands: db:generate, db:migrate, db:studio and
# by the integration tests (tests/integration).

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-XX.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

DIRECT_URL="postgresql://USER:PASSWORD@HOST.c-XX.us-east-1.aws.neon.tech/neondb?sslmode=require"
